# --- Bắt buộc ---
GEMINI_API_KEY=
TELEGRAM_TOKEN=

# --- Elasticsearch ---
ES_HOST=http://localhost:9200
ES_INDEX=hs_records
BULK_BATCH_SIZE=1000

# --- Gemini ---
GEMINI_MODEL=gemini-2.0-flash

# --- Phân quyền Telegram ---
# Danh sách chat_id được phép sử dụng bot, phân tách bằng dấu phẩy.
# Để demo công khai, đặt TELEGRAM_ALLOW_ALL=true (KHÔNG khuyến nghị cho dữ liệu thật).
TELEGRAM_ALLOWED_IDS=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOW_ALL=false

# --- Đường dẫn ---
DATA_DIR=./organized_results
HISTORY_DB=./data/chat_history.db

# --- Khác ---
HISTORY_TURNS=20
LOG_LEVEL=INFO
